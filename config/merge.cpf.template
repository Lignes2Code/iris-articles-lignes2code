[Actions]

; Configuration simplifiée - création d'utilisateur via ObjectScript
; L'utilisateur admin est créé via le script iris-init.script
; car la propriété Password n'est pas modifiable directement via CPF

; Activer l'interopérabilité dans le namespace USER
ModifyNamespace:Name=USER,Globals=USER,Routines=USER,Interop=1

; Activer le service CallIn (nécessaire pour le terminal)
ModifyService:Name=%Service_CallIn,Enabled=1,AutheEnabled=48

; Créer l'application web REST pour les articles
; MatchRoles=:%All signifie : aucun rôle requis, accorder %All à tous (y compris non authentifiés)
CreateApplication:Name=/api/articles,NameSpace=USER,DispatchClass=Article.REST.Router,AutheEnabled=64,MatchRoles=:%All,Enabled=1,Type=2
