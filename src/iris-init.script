zn "%SYS"

// Dé-expirer les mots de passe
Do ##class(Security.Users).UnExpireUserPasswords("*")

// Activer le service CallIn
do ##class(Security.Services).Get("%Service_CallIn",.prop)
set prop("Enabled")=1
set prop("AutheEnabled")=48
do ##class(Security.Services).Modify("%Service_CallIn",.prop)

// Installer la locale française
Set status = ##class(Config.NLS.Locales).Install("fraw")

// Charger WebTerminal
do $system.OBJ.Load("/tmp/WebTerminal-v4.9.5.xml","ck")

// Configurer l'application web REST avec les bons droits
Set appName = "/api/articles"
If ##class(Security.Applications).Exists(appName) {
    // Modifier les rôles si l'appli existe déjà (créée par merge.cpf)
    Do ##class(Security.Applications).Get(appName, .props)
    Set props("MatchRoles") = ":%All"
    Set props("Resource") = ""
    Set props("AutheEnabled") = 64
    Do ##class(Security.Applications).Modify(appName, .props)
    Write "Application web /api/articles configurée avec MatchRoles=:%All",!
} Else {
    // Créer l'application web si elle n'existe pas
    Set props("NameSpace") = "USER"
    Set props("DispatchClass") = "Article.REST.Router"
    Set props("Enabled") = 1
    Set props("AutheEnabled") = 64
    Set props("MatchRoles") = ":%All"
    Set props("Resource") = ""
    Set props("Type") = 2
    Do ##class(Security.Applications).Create(appName, .props)
    Write "Application web /api/articles créée",!
}

// Basculer sur le namespace USER
zn "USER"

// Charger et compiler toutes les classes ObjectScript
do $system.OBJ.LoadDir("/home/irisowner/src/cls/", "ck", .err, 1)

// Démarrer la production d'interopérabilité
do ##class(Ens.Director).StartProduction("Article.Production.ArticleProduction")